{
  "name": "quick-share-extension",
  "description": "Chrome extension to generate beautiful shareable post images from social platforms like X, Zhihu, and more.",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "compile": "wxt prepare && vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "modern-screenshot": "^4.5.5",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.0.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.14.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^2.2.8",
    "wxt": "^0.19.28"
  },
  "packageManager": "pnpm@9.11.0+sha512.0a203ffaed5a3f63242cd064c8fb5892366c103e328079318f78062f24ea8c9d50bc6a47aa3567cabefd824d170e78fa2745ed1f16b132e16436146b7688f19b"
}
